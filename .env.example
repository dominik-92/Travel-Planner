DATABASE_URL=postgresql://travelplanner:your_password_here@localhost:5432/travelplanner

# Optional base URL used to build password-reset links
APP_BASE_URL=http://localhost:8080

# Optional SMTP settings — set spring.mail.host to send password-reset emails
# via any SMTP provider; when it is unset, the reset link is written to the app
# log instead (LoggingMailService fallback).
spring.mail.host=smtp.example.com
spring.mail.port=587
spring.mail.username=<smtp_username>
spring.mail.password=<smtp_password>
spring.mail.protocol=smtp
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.ssl.enable=false
spring.mail.properties.mail.smtp.starttls.enable=true

# The "from" address for password-reset emails.
app.mail.from=<sender@example.com>
